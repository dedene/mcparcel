{
  "schemaVersion": 1,
  "credentialProfiles": {
    "sa-env": {"description": "Service account, token from OP_E2E_TOKEN (never set)"},
    "sa-file": {"description": "Service account, garbage token in a Secret-style file"},
    "sa-world": {"description": "Service account, world-readable token file"},
    "desktop-sa": {"description": "Desktop-app profile, refused in headless mode"}
  },
  "connections": {
    "front": {
      "label": "Front",
      "transport": {"type": "http", "url": "http://127.0.0.1:18081/mcp", "mode": "streamable", "allowInsecureHttp": "loopback"},
      "auth": {
        "type": "oauth",
        "grant": "client_credentials",
        "tokenUrl": "http://127.0.0.1:18080/oauth/token",
        "clientId": {"secret": "env:FRONT_CLIENT_ID"},
        "clientSecret": {"secret": "env:FRONT_CLIENT_SECRET"}
      },
      "toolPolicy": {
        "allow": ["read_conversation", "create_draft", "ask_approval"],
        "deny": ["send_message"]
      },
      "callTimeout": "60s"
    },
    "sa-env": {
      "credentialProfile": "sa-env",
      "transport": {"type": "stdio", "command": "/bin/false", "env": {"API_KEY": {"secret": "op://E2E/api/key"}}}
    },
    "sa-file": {
      "credentialProfile": "sa-file",
      "transport": {"type": "stdio", "command": "/bin/false", "env": {"API_KEY": {"secret": "op://E2E/api/key"}}}
    },
    "sa-world": {
      "credentialProfile": "sa-world",
      "transport": {"type": "stdio", "command": "/bin/false", "env": {"API_KEY": {"secret": "op://E2E/api/key"}}}
    },
    "desktop-sa": {
      "credentialProfile": "desktop-sa",
      "transport": {"type": "stdio", "command": "/bin/false", "env": {"API_KEY": {"secret": "op://E2E/api/key"}}}
    }
  }
}
